---
import '../styles/global.css';
import { SITE, withBase } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonical?: URL;
  type?: 'website' | 'article';
}

const {
  title = SITE.title,
  description = SITE.description,
  lang = 'en',
  canonical = new URL(Astro.url.pathname, Astro.site),
  type = 'website',
} = Astro.props;

const fullTitle = title === SITE.title ? title : `${title} — ${SITE.name}`;
const currentPath = Astro.url.pathname;
const writingHref = withBase('/writing/');
const aboutHref = withBase('/about/');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ebe8df" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — ${SITE.author}`}
      href={withBase('/rss.xml')}
    />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Gentium+Plus:ital,wght@0,400;0,700;1,400&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-mark" href={withBase('/')} aria-label="HUDA home">
          <span>HUDA</span>
          <small>by RIMO</small>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href={writingHref} aria-current={currentPath.startsWith(writingHref) ? 'page' : undefined}>
            Writing
          </a>
          <a href={aboutHref} aria-current={currentPath.startsWith(aboutHref) ? 'page' : undefined}>
            About
          </a>
          <a href={withBase('/rss.xml')}>RSS</a>
          <a href={SITE.github} rel="me">GitHub</a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>
          <a href={SITE.github} rel="me">RIMO on GitHub</a>
          <span aria-hidden="true"> · </span>
          <a href={withBase('/rss.xml')}>RSS</a>
        </div>
        <p class="colophon">
          <span lang="grc">{SITE.mottoGreek}</span>
          <span>— {SITE.mottoEnglish}</span>
        </p>
      </div>
    </footer>
  </body>
</html>
