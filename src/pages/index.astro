---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, formatDate, withBase, writingSlug } from '../lib/site';

const entries = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = entries.find(({ data }) => data.featured) ?? entries[0];
const recent = entries.filter((entry) => entry.id !== featured?.id).slice(0, 4);
---

<BaseLayout>
  <div class="home page-frame">
    <section class="home-intro" aria-labelledby="home-title">
      <div>
        <p class="eyebrow">A personal notebook</p>
        <h1 id="home-title">Essays and notes by RIMO.</h1>
        <p class="home-deck">
          History, literature, philosophy, cinema, music, law, and social life—read slowly,
          argued carefully.
        </p>
        <a class="text-link" href={SITE.github}>RIMO on GitHub →</a>
      </div>
      <aside class="now-note" aria-label="Current status">
        <span>Now</span>
        <p>HUDA is ready for RIMO’s first published piece. New writing will appear here.</p>
      </aside>
    </section>

    <section class="writing-home" aria-labelledby="writing-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Latest</p>
          <h2 id="writing-title">Writing</h2>
        </div>
        <a href={withBase('/writing/')}>View all</a>
      </div>

      {featured ? (
        <article class="featured-entry">
          <div class="entry-meta">
            <span>{featured.data.kind}</span>
            <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time>
            {featured.data.topics[0] && <span>{featured.data.topics[0]}</span>}
          </div>
          <h3>
            <a href={withBase(`/writing/${writingSlug(featured)}/`)}>{featured.data.title}</a>
          </h3>
          <p>{featured.data.description}</p>
          <a class="read-link" href={withBase(`/writing/${writingSlug(featured)}/`)}>Read essay →</a>
        </article>
      ) : (
        <div class="empty-state">
          <p class="empty-mark" aria-hidden="true">¶</p>
          <div>
            <h3>No writing has been published yet.</h3>
            <p>The shelves are empty on purpose. Future essays and notes will have their own permanent pages.</p>
            <a href={withBase('/rss.xml')}>Follow the RSS feed →</a>
          </div>
        </div>
      )}

      {recent.length > 0 && (
        <ol class="recent-list">
          {recent.map((entry) => (
            <li>
              <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
              <a href={withBase(`/writing/${writingSlug(entry)}/`)}>{entry.data.title}</a>
              <span>{entry.data.kind}</span>
            </li>
          ))}
        </ol>
      )}
    </section>

    <section class="home-principle" aria-labelledby="method-title">
      <p class="eyebrow">Method</p>
      <h2 id="method-title">Notes and sources only where they earn their place.</h2>
      <p>
        HUDA keeps sources, historical periods, terms, and notes close to the argument without
        letting them overwhelm it. On wide screens, footnotes sit beside the sentence they belong to;
        on smaller screens, they open in place.
      </p>
    </section>
  </div>
</BaseLayout>
